# Copy to .env and fill in. .env is gitignored — never commit it.
# Blank values fall back to the defaults in packages/core/src/config/defaults.ts.

# --- GitHub App (needed from Phase 6) ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=
# smee.io channel URL for local webhook delivery
WEBHOOK_PROXY_URL=

# --- Local infra (docker compose) ---
# Pick your own password. Compose will not start without one.
POSTGRES_USER=proof
POSTGRES_PASSWORD=
POSTGRES_DB=proof
POSTGRES_PORT=5433
REDIS_PORT=6380

# Must match the POSTGRES_* / REDIS_PORT values above.
# Example: postgresql://proof:<password>@localhost:5433/proof
DATABASE_URL=
REDIS_URL=redis://localhost:6380

# --- API server ---
HOST=127.0.0.1
PORT=3100
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- LLM ---
# ollama | openai-compatible | anthropic
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b
# Required for openai-compatible
LLM_BASE_URL=
# Required for openai-compatible and anthropic
LLM_API_KEY=
# Seconds per LLM request
LLM_TIMEOUT_S=180
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
# Replies are cached here by prompt hash. Blank = user cache folder.
LLM_CACHE_DIR=

# --- Sandbox limits (spec section 6) ---
SANDBOX_CPUS=1
# Caps memory and memory+swap
SANDBOX_MEMORY=2g
SANDBOX_PIDS_LIMIT=256
# Size of the writable /tmp inside each sandbox
SANDBOX_TMPFS_SIZE=512m
# Numeric uid:gid; root (0) is rejected
SANDBOX_USER=1000:1000
# Per step; the whole run is capped by RUN_BUDGET_S
SANDBOX_STEP_TIMEOUT_S=120
RUN_BUDGET_S=480
# stdout/stderr kept per step; anything beyond is cut off
SANDBOX_MAX_OUTPUT_BYTES=1048576
# Per-run temp folders are created here. Blank = OS temp folder.
SANDBOX_WORKDIR_ROOT=
MAX_CONCURRENT_RUNS=1

# --- Sandbox images (npm run build:images) ---
SANDBOX_IMAGE_NODE=writecode-proof/sandbox-node:1
SANDBOX_IMAGE_PYTHON=writecode-proof/sandbox-python:1
SANDBOX_IMAGE_TOOLS=writecode-proof/sandbox-tools:1
