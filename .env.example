# Copy to .env and fill in. .env is gitignored — never commit it.
# Blank values fall back to the defaults in packages/core/src/config/defaults.ts.

# --- GitHub App (needed from Phase 6) ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=
# smee.io channel URL for local webhook delivery
WEBHOOK_PROXY_URL=

# --- Local infra (docker compose) ---
# Pick your own password. Compose will not start without one.
POSTGRES_USER=proof
POSTGRES_PASSWORD=
POSTGRES_DB=proof
POSTGRES_PORT=5433
REDIS_PORT=6380

# Must match the POSTGRES_* / REDIS_PORT values above.
# Example: postgresql://proof:<password>@localhost:5433/proof
DATABASE_URL=
REDIS_URL=redis://localhost:6380

# --- API server ---
HOST=127.0.0.1
PORT=3100
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- LLM ---
# ollama | openai-compatible | anthropic
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b
# Required for openai-compatible
LLM_BASE_URL=
# Required for openai-compatible and anthropic
LLM_API_KEY=

# --- Sandbox limits ---
SANDBOX_CPUS=1
SANDBOX_MEMORY=2g
SANDBOX_STEP_TIMEOUT_S=120
RUN_BUDGET_S=480
MAX_CONCURRENT_RUNS=1
