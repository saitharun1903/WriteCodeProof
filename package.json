{
  "name": "writecode-proof",
  "version": "0.1.0",
  "private": true,
  "description": "Proof-carrying pull requests: tests, behaviour diff, security scan and a risk score for every change.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "examples": "node scripts/example-repo.mjs js-sample && node scripts/example-repo.mjs py-sample",
    "build:images": "npm run build && node scripts/build-images.mjs",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "cache:clear": "node scripts/clear-cache.mjs",
    "proof": "npm run build && node scripts/proof.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
